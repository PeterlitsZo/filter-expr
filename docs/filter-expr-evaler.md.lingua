# Crate filter-expr-evaler

\(match lang
  :zh_CN "用于求值过滤表达式的库。"
  :zh_TW "用於求值篩選運算式的函式庫。"
  :ja_JP "フィルター式を評価するライブラリです。"
  :ko_KR "필터 표현식을 평가하는 라이브러리입니다."
  :es_ES "Una biblioteca para evaluar expresiones de filtrado."
  :fr_FR "Une bibliothèque pour évaluer les expressions de filtrage."
  :de_DE "Eine Bibliothek zur Auswertung von Filterausdrücken."
  :pt_BR "Uma biblioteca para avaliar expressões de filtro."
  _ "A library for evaluating filter expressions.")

```rust
use filter_expr::FilterExpr;
use filter_expr_evaler::{CompiledFilterExpr, FilterExprEvaler, simple_context};

// Parse the filter expression.
let filter_expr = FilterExpr::parse("name = 'John' AND age > 18").unwrap();

// Build the evaler.
let filter_expr_evaler = FilterExprEvaler::new();

// Compile once and reuse the handle for evaluation.
let compiled = CompiledFilterExpr::compile(&filter_expr);
let ctx = simple_context! {
    "name": "John",
    "age": 19,
};
let result = filter_expr_evaler.run(&compiled, &ctx).await.unwrap();
assert_eq!(result, true);
```

