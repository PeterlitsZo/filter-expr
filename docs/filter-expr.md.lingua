\(match lang
  :zh_CN "### 过滤器"
  :zh_TW "### 篩選器"
  :ja_JP "### フィルター"
  :ko_KR "### 필터"
  :es_ES "### Filtro"
  :fr_FR "### Filtre"
  :de_DE "### Filter"
  :pt_BR "### Filtro"
  _ "### Filter")

```
<filter> = <expr> | <empty>

<empty> =
```

\(match lang
  :zh_CN "### 表达式"
  :zh_TW "### 運算式"
  :ja_JP "### 式"
  :ko_KR "### 표현식"
  :es_ES "### Expresión"
  :fr_FR "### Expression"
  :de_DE "### Ausdruck"
  :pt_BR "### Expressão"
  _ "### Expression")

```
<expr> = <let-expr> | <logical-expr>
<let-expr> = 'let' <ident> ':=' <logical-expr> 'then' <expr>
<logical-expr> = <or_test> (<or> <or_test>)*

<or_test> = <and_test> (<and> <and_test>)*
<and_test> = <not> <and_test> | <comparison>

<or> = 'OR' | 'or' | '||'
<and> = 'AND' | 'and' | '&&'
<not> = 'NOT' | 'not' | '!'
```

\(match lang
  :zh_CN "### 比较"
  :zh_TW "### 比較"
  :ja_JP "### 比較"
  :ko_KR "### 비교"
  :es_ES "### Comparación"
  :fr_FR "### Comparaison"
  :de_DE "### Vergleich"
  :pt_BR "### Comparação"
  _ "### Comparison")

```
<comparison> = <additive> <operator> <comparison>
             | <additive>

<additive> = <multiplicative> (('+' | '-') <multiplicative>)*
<multiplicative> = <unary> (('*' | '/' | '%') <unary>)*
<unary> = ('+' | '-') <unary> | <primary>

<primary> = <func-call>
          | <method-call>
          | <field-access>
          | <value>

<operator> = '=' | '==' | '>' | '<' | '>=' | '<=' | '!=' | <in> | ('NOT' | 'not') <in>
<in> = 'IN' | 'in'

<namespace-prefix> = (<ident> '::')+
<func-call> = <namespace-prefix>? <ident> '(' [<expr> (',' <expr>)* ','?] ')'
<method-call> = <value> '.' <ident> '(' [<expr> (',' <expr>)* ','?] ')'
<field-access> = <value> '.' <ident>

<value> = <str>
        | <i64>
        | <f64>
        | <bool>
        | <null>
        | <ident>
        | <array>
        | <object>
        | '(' <expr> ')'

<array> = '[' [<expr> (',' <expr>)* ','?] ']'
<object> = '{' [<str> ':' <expr> (',' <str> ':' <expr>)* ','?] '}'
```
