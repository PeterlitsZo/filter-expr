\(match lang
  :zh_CN "## 快速开始"
  :zh_TW "## 快速開始"
  :ja_JP "## クイックスタート"
  :ko_KR "## 빠른 시작"
  :es_ES "## Inicio rápido"
  :fr_FR "## Démarrage rapide"
  :de_DE "## Schnellstart"
  :pt_BR "## Início rápido"
  _ "## Quick Start")

```rust
use filter_expr::FilterExpr;
use filter_expr_evaler::{CompiledFilterExpr, FilterExprEvaler, simple_context};

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    // Parse the filter expression.
    let filter = FilterExpr::parse("name = 'John' AND age > 18")?;

    // Provide values for the variables in the expression.
    let ctx = simple_context! {
        "name": "John",
        "age": 19,
    };

    // Compile once, then reuse the handle across contexts.
    let evaler = FilterExprEvaler::new();
    let compiled = CompiledFilterExpr::compile(&filter);
    assert!(evaler.run(&compiled, &ctx).await?);

    Ok(())
}
```

\(match lang
  :zh_CN """
    | 可在不同上下文和求值器之间复用或克隆 `compiled`。
    | 每个求值器提供自己的函数、方法和正则表达式缓存。
  """
  :zh_TW """
    | 可在不同上下文與求值器之間重複使用或複製 `compiled`。
    | 每個求值器提供自己的函式、方法與正規表示式快取。
  """
  :ja_JP """
    | `compiled` は異なるコンテキストや評価器で再利用・複製できます。
    | 各評価器は独自の関数、メソッド、正規表現キャッシュを持ちます。
  """
  :ko_KR """
    | 여러 컨텍스트와 평가기에서 `compiled`를 재사용하거나 복제할 수 있습니다.
    | 각 평가기는 자체 함수, 메서드, 정규식 캐시를 제공합니다.
  """
  :es_ES """
    | Reutiliza o clona `compiled` con distintos contextos y evaluadores. Cada evaluador proporciona
    | sus propias funciones, métodos y caché de expresiones regulares.
  """
  :fr_FR """
    | Réutilisez ou clonez `compiled` avec différents contextes et évaluateurs. Chaque évaluateur fournit
    | ses propres fonctions, méthodes et cache d’expressions régulières.
  """
  :de_DE """
    | Verwende oder klone `compiled` für verschiedene Kontexte und Evaluatoren. Jeder Evaluator stellt
    | eigene Funktionen, Methoden und einen eigenen Regex-Cache bereit.
  """
  :pt_BR """
    | Reutilize ou clone `compiled` com diferentes contextos e avaliadores. Cada avaliador fornece
    | suas próprias funções, métodos e cache de expressões regulares.
  """
  _ """
    | Reuse or clone `compiled` across contexts and evaluators. Each evaluator supplies
    | its own functions, methods, and regex cache.
  """)

